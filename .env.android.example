# Local Android signing configuration
# Copy this file to .env.android or secrets.android.env (both are gitignored).
#
# This keystore is permanent: the store only accepts updates signed with the
# same key, and the certificate is shown on the store listing. Generate it once,
# back it up, and never commit it.

# Option 1: Path to local keystore file (relative to repo root or absolute)
KEYSTORE_PATH="secrets/release.keystore"

# Option 2: Base64-encoded keystore (same as GitHub Secret ANDROID_KEYSTORE_BASE64)
# KEYSTORE_BASE64=""

# Keystore Credentials — required when no keystore exists yet;
# the build refuses to invent one with a weak default password.
KEYSTORE_PASSWORD=""
KEY_ALIAS="audiflow"
KEY_PASSWORD=""
